+    async def async_discover_ivs_rules(self):
+        """Discover read-only IVS sensors without changing any camera settings."""
+        rules = []
+        is_recorder = any(kind in str(self.model).upper() for kind in ("NVR", "DVR", "XVR"))
+        try:
+            if is_recorder:
+                # This per-channel table is authoritative on Web5.0 NVRs.
+                table = await self.client.async_get_remote_ivs_rules(self._channel)
+                rules = rules_from_remote(table, self._channel)
+            else:
+                table = await self.client.async_get_ivs_rules()
+                rules = rules_from_flat(table, self._channel)
+        except Exception as error:
+            # An optional rule read must never take working motion sensors down.
+            _LOGGER.warning(
+                "Hybrid IVS discovery unavailable for %s channel %s (%s); existing sensors continue",
+                self._address, self._channel, type(error).__name__,
+            )
+            return []
+        self._ivs_tracker = IVSRuleTracker(rules)
+        _LOGGER.info(
+            "Hybrid IVS discovery: %s channel %s, %s normal rules",
+            self._address, self._channel, len(rules),
+        )
+        return rules
+
+    def _handle_ivs_rule_event(self, event):
+        """Dispatch optional rule state without interrupting legacy callbacks."""
+        tracker = self._ivs_tracker
+        if tracker is None:
+            return
+        try:
+            previous = tracker.unmatched_count
+            changed = tracker.apply(event)
+            if tracker.unmatched_count > previous and previous == 0:
+                _LOGGER.warning(
+                    "Hybrid IVS event ID does not match discovery on %s channel %s: %s; no rule guessed",
+                    self._address, self._channel, tracker.last_unmatched,
+                )
+            for identity in changed:
+                listener = self._ivs_rule_listeners.get(identity)
+                if listener is not None:
+                    listener()
+        except Exception:
+            _LOGGER.exception("Optional hybrid IVS event handling failed")
+
+    def add_ivs_rule_listener(self, identity, listener):
+        """Register one new IVS entity and return its unload cleanup."""
+        self._ivs_rule_listeners[identity] = listener
+
+        def remove():
+            if self._ivs_rule_listeners.get(identity) is listener:
+                self._ivs_rule_listeners.pop(identity, None)
+
+        return remove
 
